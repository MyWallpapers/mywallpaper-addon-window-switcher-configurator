      "parent": "layoutSection",
      "default": 16,
      "scope": "device",
      "min": 4,
      "max": 40,
      "step": 1
    },
    {
      "id": "padding",
      "type": "range",
      "label": "Marge intérieure (px)",
      "parent": "layoutSection",
      "default": 28,
      "scope": "device",
      "min": 12,
      "max": 52,
      "step": 1
    },
    {
      "id": "cardRadius",
      "type": "range",
      "label": "Coins des cartes (px)",
      "parent": "layoutSection",
      "default": 14,
      "scope": "device",
      "min": 0,
      "max": 32,
      "step": 1
    },
    {
      "id": "pageSize",
      "type": "range",
      "label": "Cartes par page au maximum",
      "parent": "layoutSection",
      "default": 24,
      "scope": "device",
      "min": 4,
      "max": 48,
      "step": 1
    },
    {
      "id": "sort",
      "type": "select",
      "label": "Ordre des fenêtres",
      "parent": "layoutSection",
      "default": "recent",
      "scope": "device",
      "options": [
        {
          "value": "recent",
          "label": "Dernières utilisées"
