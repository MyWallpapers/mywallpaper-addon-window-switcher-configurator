        {
          "value": "cursor",
          "label": "Écran du pointeur"
        },
        {
          "value": "focused",
          "label": "Écran de la fenêtre active"
        }
      ]
    },
    {
      "id": "minimized",
      "type": "select",
      "label": "Fenêtres réduites",
      "parent": "filterSection",
      "default": "include",
      "scope": "device",
      "options": [
        {
          "value": "include",
          "label": "Inclure"
        },
        {
          "value": "exclude",
          "label": "Masquer"
        },
        {
          "value": "only",
          "label": "Seulement les fenêtres réduites"
        }
      ]
    },
    {
      "id": "includeApplications",
      "type": "textarea",
      "label": "Montrer uniquement ces applications",
      "parent": "filterSection",
      "default": "",
      "scope": "device",
      "description": "Facultatif : noms des exécutables, un par ligne, par exemple notepad.exe. Laissez vide pour toutes les applications.",
      "placeholder": "notepad.exe\nexplorer.exe"
    },
    {
      "id": "excludeApplications",
      "type": "textarea",
      "label": "Applications à masquer",
      "parent": "filterSection",
      "default": "",
      "scope": "device",
      "description": "Facultatif : noms des exécutables, un par ligne. Aucun code ni sélecteur nécessaire.",
      "placeholder": "exemple.exe"
    },
    {
      "id": "hideGhosts",
      "type": "boolean",
      "label": "Masquer les fenêtres fantômes",
      "parent": "filterSection",
      "default": true,
      "scope": "device",
      "description": "Écarte les fenêtres nommées Ghost et les fenêtres minuscules qui ne peuvent pas servir d’aperçu."
    },
    {
      "id": "minWindowSize",
      "type": "range",
      "label": "Seuil des fenêtres minuscules (px)",
      "parent": "filterSection",
      "default": 48,
      "scope": "device",
      "min": 0,
      "max": 200,
      "step": 4,
      "description": "Masque les fenêtres dont les deux dimensions sont inférieures à ce seuil.",
      "showIf": {
        "setting": "hideGhosts",
        "equals": true
      }
    },
    {
      "id": "hideUntitled",
      "type": "boolean",
      "label": "Masquer les fenêtres sans titre",
      "parent": "filterSection",
      "default": true,
      "scope": "device",
      "description": "Les fenêtres sans titre sont souvent des utilitaires invisibles."
    },
    {
      "id": "hideHung",
      "type": "boolean",
      "label": "Masquer les applications qui ne répondent pas",
      "parent": "filterSection",
      "default": false,
      "scope": "device",
      "description": "Ce filtre ne ferme pas et ne force pas l’arrêt de l’application."
    },
    {
