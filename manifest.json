          "label": "Normale"
        },
        {
          "value": "medium",
          "label": "Moyenne"
        },
        {
          "value": "semibold",
          "label": "Semi-grasse"
        }
      ]
    },
    {
      "id": "navigationSection",
      "type": "section",
      "label": "Navigation et actions",
      "defaultCollapsed": false
    },
    {
      "id": "wrapNavigation",
      "type": "boolean",
      "label": "Revenir au début après la dernière fenêtre",
      "parent": "navigationSection",
      "default": true,
      "scope": "device",
      "description": "S’applique à Tab, aux flèches et à la molette."
    },
    {
      "id": "hoverSelect",
      "type": "boolean",
      "label": "Sélectionner au survol",
      "parent": "navigationSection",
      "default": false,
      "scope": "device",
      "description": "Le clic choisit toujours la fenêtre."
    },
    {
      "id": "mouseWheel",
      "type": "boolean",
      "label": "Parcourir avec la molette",
      "parent": "navigationSection",
      "default": true,
      "scope": "device",
      "description": "Une encoche sélectionne la carte suivante ou précédente."
    },
    {
      "id": "showClose",
      "type": "boolean",
      "label": "Bouton Fermer sur les cartes",
      "parent": "navigationSection",
      "default": true,
      "scope": "device",
      "description": "Demande une fermeture normale ; l’application peut demander d’enregistrer."
    },
    {
      "id": "closeConfirm",
      "type": "boolean",
      "label": "Confirmer avant de fermer",
      "parent": "navigationSection",
      "default": true,
      "scope": "device",
      "description": "La confirmation fonctionne aussi avec Suppr."
    },
    {
      "id": "searchEnabled",
      "type": "boolean",
      "label": "Rechercher par titre ou application",
      "parent": "navigationSection",
      "default": true,
      "scope": "device",
      "description": "Dans le sélecteur ouvert par raccourci, commencez à saisir pour filtrer."
    },
    {
      "id": "dismissOutside",
      "type": "boolean",
      "label": "Annuler en cliquant hors du panneau",
      "parent": "navigationSection",
      "default": true,
      "scope": "device",
      "description": "L’application précédemment active retrouve le focus."
    },
    {
      "id": "dismissOnFocusLoss",
      "type": "boolean",
      "label": "Annuler quand une autre application prend le focus",
      "parent": "navigationSection",
      "default": true,
      "scope": "device",
      "description": "Ne garde pas le sélecteur au-dessus d’une autre action."
    },
    {
      "id": "showHints",
      "type": "boolean",
      "label": "Afficher les commandes clavier",
      "parent": "navigationSection",
      "default": true,
      "scope": "device",
      "description": "Tab et flèches : parcourir ; Entrée : choisir ; Échap : annuler ; Suppr : fermer."
    },
    {
      "id": "motionSection",
      "type": "section",
      "label": "Mouvements",
      "defaultCollapsed": false
    },
    {
      "id": "animationMode",
      "type": "select",
      "label": "Ouverture du panneau",
      "parent": "motionSection",
      "default": "slide",
      "scope": "device",
      "options": [
        {
          "value": "none",
          "label": "Immédiate"
        },
        {
          "value": "fade",
          "label": "Fondu"
        },
        {
          "value": "slide",
          "label": "Glissement doux"
        },
        {
          "value": "spring",
          "label": "Ressort léger"
        }
      ]
    },
    {
      "id": "animationDurationMs",
      "type": "range",
      "label": "Durée d’ouverture (ms)",
      "parent": "motionSection",
      "default": 190,
      "scope": "device",
      "min": 0,
      "max": 700,
      "step": 10
    },
    {
      "id": "selectionDurationMs",
      "type": "range",
      "label": "Transition de sélection (ms)",
      "parent": "motionSection",
      "default": 120,
      "scope": "device",
      "min": 0,
      "max": 400,
      "step": 10
    },
    {
      "id": "hoverScale",
      "type": "range",
      "label": "Agrandissement au survol",
      "parent": "motionSection",
      "default": 1.03,
      "scope": "device",
      "min": 1,
      "max": 1.1,
      "step": 0.01
    },
    {
      "id": "hoverLift",
      "type": "range",
      "label": "Soulèvement au survol (px)",
      "parent": "motionSection",
      "default": 3,
      "scope": "device",
      "min": 0,
      "max": 12,
      "step": 1
    },
    {
      "id": "flipDepth",
      "type": "range",
      "label": "Écart de profondeur en cascade (px)",
      "parent": "motionSection",
      "default": 44,
      "scope": "device",
      "min": 20,
      "max": 90,
      "step": 2,
      "showIf": {
        "setting": "layout",
        "equals": "flip"
      }
    },
    {
      "id": "flipVisible",
      "type": "range",
      "label": "Cartes visibles dans la cascade",
      "parent": "motionSection",
      "default": 5,
      "scope": "device",
      "min": 3,
      "max": 9,
      "step": 1,
      "showIf": {
        "setting": "layout",
        "equals": "flip"
      }
    },
    {
      "id": "reduceMotion",
      "type": "boolean",
      "label": "Réduire les animations",
      "parent": "motionSection",
      "default": false,
      "scope": "device",
      "description": "Coupe l’entrée, le survol animé et les transitions."
    },
    {
      "id": "followWindowsMotion",
      "type": "boolean",
      "label": "Respecter la réduction d’animation de Windows",
      "parent": "motionSection",
      "default": true,
      "scope": "device",
      "description": "Suit le réglage d’accessibilité Windows."
    },
    {
      "id": "advancedSection",
      "type": "section",
      "label": "Performance — facultatif",
      "defaultCollapsed": true
    },
    {
      "id": "previewBudget",
      "type": "range",
      "label": "Aperçus simultanés au maximum",
      "parent": "advancedSection",
      "default": 24,
      "scope": "device",
      "min": 4,
      "max": 48,
      "step": 1,
      "description": "Les autres cartes gardent titre et icône. Aucun contenu de fenêtre n’est enregistré sur disque."
    },
    {
      "id": "refreshMs",
      "type": "range",
      "label": "Actualiser la liste toutes les (ms)",
      "parent": "advancedSection",
      "default": 1000,
      "scope": "device",
      "min": 500,
      "max": 5000,
      "step": 100
    },
    {
      "id": "maxCandidates",
      "type": "range",
      "label": "Fenêtres examinées au maximum",
      "parent": "advancedSection",
      "default": 160,
      "scope": "device",
      "min": 16,
      "max": 240,
      "step": 8
    }
  ],
  "native": {
    "companion": {
      "runtime": "process-v2",
      "entries": {
        "windows-x86_64": "native/out/windows-x86_64/companion.exe"
