{
  "runtime": "native-v1",
  "name": "Sélecteur de fenêtres",
  "description": "Un sélecteur personnalisable : grille, liste, classique, cascade et carte du bureau, avec aperçus DWM, profils et navigation clavier.",
  "version": "0.1.1",
  "deviceSettingsVersion": "1",
  "settings": [
    {
      "id": "startSection",
      "type": "section",
      "label": "Votre sélecteur",
      "defaultCollapsed": false,
      "description": "Choisissez un profil, puis une présentation. Les réglages s’appliquent à cet appareil."
    },
    {
      "id": "enabled",
      "type": "boolean",
      "label": "Activer le sélecteur",
      "parent": "startSection",
      "default": true,
      "scope": "device",
      "description": "À l’arrêt, le raccourci et tous les aperçus sont libérés."
    },
    {
      "id": "profile",
      "type": "select",
      "label": "Ambiance visuelle",
      "parent": "startSection",
      "default": "boreal",
      "scope": "device",
      "options": [
        {
          "value": "boreal",
          "label": "Verre boréal"
        },
        {
          "value": "midnight",
          "label": "Minuit"
        },
        {
          "value": "rose",
          "label": "Rose électrique"
        },
        {
          "value": "paper",
          "label": "Papier"
        },
        {
          "value": "cinema",
          "label": "Cinéma"
        },
        {
          "value": "classic",
          "label": "Classique"
        },
        {
          "value": "flip",
          "label": "Cascade Flip"
        },
        {
          "value": "custom",
          "label": "Personnalisée"
        }
      ],
      "description": "Les profils fixent la palette et la matière. Personnalisée dévoile les couleurs ; les choix personnels sont conservés quand vous changez de profil."
    },
    {
      "id": "layout",
      "type": "select",
      "label": "Présentation",
      "parent": "startSection",
      "default": "profile",
      "scope": "device",
      "options": [
        {
          "value": "profile",
          "label": "Conseillée par le profil"
        },
        {
          "value": "grid",
          "label": "Grille d’aperçus"
        },
        {
          "value": "list",
          "label": "Liste détaillée"
        },
        {
          "value": "classic",
          "label": "Classique compact"
        },
        {
          "value": "flip",
          "label": "Cascade inspirée de Flip 3D"
        },
        {
          "value": "desktop",
          "label": "Carte des fenêtres du bureau"
        }
      ],
      "description": "La carte reprend la position des fenêtres sur l’écran choisi. La cascade propose un effet de profondeur sans restaurer le composant Vista."
    },
    {
      "id": "activationMode",
      "type": "select",
      "label": "Ouvrir le sélecteur",
      "parent": "startSection",
      "default": "shortcut",
      "scope": "device",
      "options": [
        {
          "value": "shortcut",
          "label": "Raccourci dédié"
        },
        {
          "value": "altTab",
          "label": "Alt + Tab et raccourci dédié"
        }
      ],
      "description": "Le raccourci dédié laisse le sélecteur ouvert. Avec Alt + Tab, relâchez Alt pour choisir. Win + Tab conserve Task View de Windows."
    },
    {
      "id": "shortcut",
      "type": "select",
      "label": "Raccourci dédié",
      "parent": "startSection",
      "default": "ctrlAltSpace",
      "scope": "device",
      "options": [
        {
          "value": "ctrlAltSpace",
          "label": "Ctrl + Alt + Espace"
        },
        {
          "value": "ctrlShiftSpace",
          "label": "Ctrl + Maj + Espace"
        },
        {
          "value": "altBacktick",
          "label": "Alt + touche `"
        }
      ],
      "description": "Appuyez de nouveau pour annuler. Le raccourci est actif uniquement pendant l’exécution de cet add-on."
    },
    {
      "id": "openDelayMs",
      "type": "range",
      "label": "Délai d’apparition (ms)",
      "parent": "startSection",
      "default": 120,
      "scope": "device",
      "min": 0,
      "max": 600,
      "step": 10,
      "description": "Un Alt + Tab très bref change de fenêtre sans faire apparaître le panneau."
    },
    {
      "id": "fullscreenBypass",
      "type": "boolean",
      "label": "Garder Alt + Tab Windows en plein écran",
      "parent": "startSection",
      "default": true,
      "scope": "device",
      "description": "Évite d’intercepter Alt + Tab quand la fenêtre active couvre tout son écran."
    },
    {
      "id": "layoutSection",
      "type": "section",
      "label": "Disposition et densité",
      "defaultCollapsed": false
    },
    {
      "id": "placement",
      "type": "select",
      "label": "Écran d’affichage",
      "parent": "layoutSection",
      "default": "cursor",
      "scope": "device",
      "options": [
        {
          "value": "cursor",
          "label": "Sous le pointeur"
        },
        {
          "value": "focused",
          "label": "Fenêtre active"
        },
        {
          "value": "primary",
          "label": "Écran principal"
        }
      ]
    },
    {
      "id": "panelWidthPct",
      "type": "range",
      "label": "Largeur maximale (% de l’écran)",
      "parent": "layoutSection",
      "default": 80,
      "scope": "device",
      "min": 40,
      "max": 96,
      "step": 1
    },
    {
      "id": "panelHeightPct",
      "type": "range",
      "label": "Hauteur maximale (% de l’écran)",
      "parent": "layoutSection",
      "default": 80,
      "scope": "device",
      "min": 35,
      "max": 94,
      "step": 1
    },
    {
      "id": "columns",
      "type": "range",
