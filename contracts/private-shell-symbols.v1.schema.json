{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minimal technical request for build-bound private symbol resolution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "module", "symbols", "timeoutMs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageName", "architecture", "sha256", "peTimestamp", "pdbGuid", "pdbAge", "pdbName"],
      "properties": {
        "imageName": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^/\\\\:]+\\.(dll|exe)$" },
        "architecture": { "const": "windows-x86_64" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "peTimestamp": { "type": "integer", "minimum": 0 },
        "pdbGuid": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "pdbAge": { "type": "integer", "minimum": 1 },
        "pdbName": { "type": "string", "minLength": 1 }
      }
    },
    "symbols": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } },
    "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 5000 }
  }
}

